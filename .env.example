# ResultsPortalLink (D-07). Build-time HTTPS URLs. Not Operator-editable.
# Allowlisted hosts: example.invalid, nileegyptlabresults.com, www.nileegyptlabresults.com
# Setting one of these variables without the other is a build error.
# Production values are set in the deployment environment, not in this file.

RESULTS_PORTAL_VISITOR_URL=https://example.invalid/portal-placeholder
RESULTS_PORTAL_LAB_TO_LAB_URL=https://example.invalid/portal-placeholder
